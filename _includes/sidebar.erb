<aside class="ad-doc-sidebar" data-sidebar data-collapsed="true">
  <button class="ad-doc-nav-toggle" data-size="sm"
          data-nav-toggle aria-expanded="false" aria-controls="ad-doc-nav">
    <span>Browse the system</span>
    <span aria-hidden="true">☰</span>
  </button>

  <nav class="ad-doc-nav" id="ad-doc-nav" aria-label="Design system">
    <% site.data.nav.each do |group| -%>
    <div class="ad-doc-nav__group">
      <h2 class="ad-doc-nav__heading"><%= group.title %></h2>
      <% group.links.each do |link| -%>
      <% href = relative_url(link.url) -%>
      <a class="ad-doc-nav__link" href="<%= href %>"
         <% if page.url == link.url %>aria-current="page"<% end %>><%= link.text %></a>
      <% end -%>
    </div>
    <% end -%>
  </nav>
</aside>
