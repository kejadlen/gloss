<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#faf9f7" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0e0d0b" media="(prefers-color-scheme: dark)">

<%= render("seo") %>

<!-- The system's one loaded webfont — see _data/tokens/scale.yml's
     typography.webfont_import. Sans is a web-safe system stack; nothing is
     fetched for it. -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap">

<!-- Generated from _data/tokens/*.yml at build time. -->
<link rel="stylesheet" href="<%= relative_url('/assets/css/tokens.css') %>">
<link rel="stylesheet" href="<%= relative_url('/assets/css/style.css') %>">

<link rel="icon" href="<%= relative_url('/assets/favicon.svg') %>" type="image/svg+xml">

<!-- Applied before first paint so an explicit theme choice never flashes. -->
<script>
  (function () {
    try {
      var stored = localStorage.getItem("ad-theme");
      if (stored === "dark" || stored === "light") {
        document.documentElement.setAttribute("data-theme", stored);
      }
    } catch (error) {
      /* Private windows and blocked storage are fine; the media query covers us. */
    }
  })();
</script>
