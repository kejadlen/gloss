<!DOCTYPE html>
<html lang="<%= site.lang || 'en' %>">
<head>
  <%= render("head") %>
</head>
<body>
  <a class="ad-doc-skip" href="#main">Skip to content</a>

  <header class="ad-doc-header">
    <div class="ad-doc-header__inner">
      <%= render("wordmark") %>
      <div class="ad-doc-header__actions">
        <%= render("theme-toggle") %>
        <a class="btn" data-size="sm"
           href="https://github.com/<%= site.repository %>">Source</a>
      </div>
    </div>
  </header>

  <div class="ad-doc-layout">
    <%= render("sidebar") %>
    <main class="ad-doc-main" id="main">
      <%= content %>
    </main>
  </div>

  <footer class="ad-doc-footer">
    <div class="ad-doc-footer__inner">
      <p>
        <%= site.title %> v<%= site.data.meta.version %> — built with Ruby
        <%= RUBY_VERSION %>.
      </p>
      <p><a href="https://github.com/<%= site.repository %>">View the source</a></p>
    </div>
  </footer>

  <script src="<%= relative_url('/assets/js/system.js') %>" defer></script>
</body>
</html>
